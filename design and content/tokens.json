  "surface": {
    "bone-canvas": {
      "$value": "#f3f3f1",
      "$type": "color",
      "$description": "Surface level 0: Base page background (catalog, dashboard, checkout)"
    },
    "plaster-white": {
      "$value": "#ffffff",
      "$type": "color",
      "$description": "Surface level 1: Pill nav, course cards, inputs"
    },
    "color-section-band": {
      "$value": "#d2e823",
      "$type": "color",
      "$description": "Surface level 2: Hero and call-to-action bands"
    },
    "color-section-band-alt": {
      "$value": "#2665d6",
      "$type": "color",
      "$description": "Surface level 3: Categories / learning paths bands"
    },
    "deep-section-band": {
      "$value": "#780016",
      "$type": "color",
      "$description": "Surface level 4: FAQ and footer depth sections"
    },
    "cement-overlay": {
      "$value": "#adadad",
      "$type": "color",
      "$description": "Surface level 5: Muted overlays and disabled cards"
    }
  }
