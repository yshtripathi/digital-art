{
  "$description": "[Website Name] e-learning design tokens. Same color-block theme as the original reference, lightly updated for course pages. Mirrors variables.css.",
  "color": {
    "voltage-lime": {
      "$value": "#d2e823",
      "$type": "color",
      "$description": "Voltage Lime — Primary action buttons, highlighted headlines, accent surfaces. Use with Midnight Ink text (11.44:1). Never as text on white (1.37:1)."
    },
    "cobalt-signal": {
      "$value": "#2665d6",
      "$type": "color",
      "$description": "Cobalt Signal — Full-bleed section backgrounds, link accents. White text 5.36:1; lime only for large bold headlines (3.91:1)."
    },
    "bordeaux-maroon": {
      "$value": "#780016",
      "$type": "color",
      "$description": "Bordeaux Maroon — FAQ and deep sections. White text 11.6:1, Lilac Whisper text 7.28:1."
    },
    "midnight-ink": {
      "$value": "#1e2330",
      "$type": "color",
      "$description": "Midnight Ink — Primary text, icon fills, dark UI outlines. 14.12:1 on Bone Canvas."
    },
    "plaster-white": {
      "$value": "#ffffff",
      "$type": "color",
      "$description": "Plaster White — Course cards, button text, pill nav background."
    },
    "bone-canvas": {
      "$value": "#f3f3f1",
      "$type": "color",
      "$description": "Bone Canvas — Page background for catalog, course detail, dashboard, cart and checkout."
    },
    "cement-gray": {
      "$value": "#adadad",
      "$type": "color",
      "$description": "Cement Gray — Muted card backgrounds and disabled surfaces. Background only, never text on white."
    },
    "slate-mute": {
      "$value": "#676b5f",
      "$type": "color",
      "$description": "Slate Mute — Secondary text (duration, lesson count, meta). 5.46:1 on white, 4.92:1 on Bone Canvas."
    },
    "carbon": {
      "$value": "#222222",
      "$type": "color",
      "$description": "Carbon — Deep button text and borders for inverted controls."
    },
    "lilac-whisper": {
      "$value": "#e9c0e9",
      "$type": "color",
      "$description": "Lilac Whisper — Decorative borders, soft accent washes, text on maroon."
    },
    "indigo-abyss": {
      "$value": "#061492",
      "$type": "color",
      "$description": "Indigo Abyss — Deep card surfaces, Advanced level tag. White text 13.79:1."
    },
    "forest-depth": {
      "$value": "#254f1a",
      "$type": "color",
      "$description": "Forest Depth — Bordered cards, Beginner level tag. White text 9.49:1."
    },
    "saffron": {
      "$value": "#d6a337",
      "$type": "color",
      "$description": "Saffron — Card accent backgrounds, star ratings, 'Most popular' badge. Midnight Ink text 6.84:1."
    },
    "success": {
      "$value": "#1f7a3a",
      "$type": "color",
      "$description": "Success — Completed lessons, payment success. 5.38:1 on white."
    },
    "error": {
      "$value": "#c0262d",
      "$type": "color",
      "$description": "Error — Form errors, payment failed. 5.9:1 on white."
    },
    "rating": {
      "$value": "#d6a337",
      "$type": "color",
      "$description": "Rating — Star icons (Saffron). Icons only."
    },
    "progress-track": {
      "$value": "#e4e4df",
      "$type": "color",
      "$description": "Progress Track — Unfilled part of course progress bars."
    }
  },
  "font": {
    "primary": {
      "$value": "Inter",
      "$type": "fontFamily",
      "$description": "Primary brand typeface — geometric sans used from nav to 80px display headlines. Weight 700–800 at large sizes with negative letter-spacing. Falls back to Noto Sans JP for Japanese."
    },
    "arial": {
      "$value": "Arial",
      "$type": "fontFamily",
      "$description": "System fallback only."
    }
  },
  "typography": {
    "xs": {
      "$value": { "fontFamily": "Inter", "fontSize": "12px", "fontWeight": 400, "lineHeight": 1.5 },
      "$type": "typography",
      "$description": "Captions, level tags"
    },
    "sm": {
      "$value": { "fontFamily": "Inter", "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.5 },
      "$type": "typography",
      "$description": "Course meta (duration, lessons), nav links"
    },
    "sm-bold": {
      "$value": { "fontFamily": "Inter", "fontSize": "14px", "fontWeight": 700, "lineHeight": 1.5 },
      "$type": "typography",
      "$description": "Buttons, eyebrow labels"
    },
    "base": {
      "$value": { "fontFamily": "Inter", "fontSize": "16px", "fontWeight": 400, "lineHeight": 1.5 },
      "$type": "typography",
      "$description": "Body text"
    },
    "base-medium": {
      "$value": { "fontFamily": "Inter", "fontSize": "16px", "fontWeight": 500, "lineHeight": 1.5 },
