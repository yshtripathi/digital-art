      "$description": "Lead paragraphs"
    },
    "xl": {
      "$value": { "fontFamily": "Inter", "fontSize": "20px", "fontWeight": 700, "lineHeight": 1.31 },
      "$type": "typography",
      "$description": "Course card titles"
    },
    "2xl": {
      "$value": { "fontFamily": "Inter", "fontSize": "24px", "fontWeight": 700, "lineHeight": 1.2 },
      "$type": "typography",
      "$description": "Section subheadings, credits price"
    },
    "2xl-2": {
      "$value": { "fontFamily": "Inter", "fontSize": "28px", "fontWeight": 700, "lineHeight": 1.2 },
      "$type": "typography",
      "$description": "Page headings"
    },
    "5xl": {
      "$value": { "fontFamily": "Inter", "fontSize": "51px", "fontWeight": 700, "lineHeight": 1.06 },
      "$type": "typography",
      "$description": "Course detail title (desktop)"
    },
    "5xl-2": {
      "$value": { "fontFamily": "Inter", "fontSize": "56px", "fontWeight": 800, "lineHeight": 1.06 },
      "$type": "typography",
      "$description": "Section display headline"
    },
    "5xl-3": {
      "$value": { "fontFamily": "Inter", "fontSize": "80px", "fontWeight": 800, "lineHeight": 1.0 },
      "$type": "typography",
      "$description": "Homepage hero (desktop only; 40–48px on mobile)"
    }
  },
  "spacing": {
    "4": { "$value": "4px", "$type": "dimension" },
    "8": { "$value": "8px", "$type": "dimension" },
    "10": { "$value": "10px", "$type": "dimension" },
    "14": { "$value": "14px", "$type": "dimension" },
    "16": { "$value": "16px", "$type": "dimension" },
    "18": { "$value": "18px", "$type": "dimension" },
    "20": { "$value": "20px", "$type": "dimension" },
    "22": { "$value": "22px", "$type": "dimension" },
    "24": { "$value": "24px", "$type": "dimension" },
    "26": { "$value": "26px", "$type": "dimension" },
    "40": { "$value": "40px", "$type": "dimension" },
    "48": { "$value": "48px", "$type": "dimension" },
    "64": { "$value": "64px", "$type": "dimension" },
    "65": { "$value": "65px", "$type": "dimension" },
    "128": { "$value": "128px", "$type": "dimension" },
    "216": { "$value": "216px", "$type": "dimension" }
  },
  "radius": {
    "lg": { "$value": "8px", "$type": "dimension", "$description": "Inputs" },
    "2xl": { "$value": "16px", "$type": "dimension", "$description": "Course thumbnails, accordion rows" },
    "3xl": { "$value": "28px", "$type": "dimension" },
    "3xl-2": { "$value": "32px", "$type": "dimension", "$description": "Feature cards, section panels" },
    "3xl-3": { "$value": "40px", "$type": "dimension" },
    "full": { "$value": "64px", "$type": "dimension" },
    "full-2": { "$value": "99px", "$type": "dimension" },
    "full-3": { "$value": "1000px", "$type": "dimension", "$description": "Pill nav" },
    "course-card": { "$value": "24px", "$type": "dimension", "$description": "Course cards" },
    "buttons": { "$value": "9999px", "$type": "dimension", "$description": "Buttons, tags" }
