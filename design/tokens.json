  "font": {
    "family": {
      "display": {
        "$value": [
          "Fraunces",
          "Georgia",
          "Times New Roman",
          "serif"
        ],
        "$type": "fontFamily",
        "$description": "Headings, course titles, hero — an expressive serif with a friendly, editorial feel"
      },
      "body": {
        "$value": [
          "Source Sans 3",
          "ui-sans-serif",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "sans-serif"
        ],
        "$type": "fontFamily",
        "$description": "All UI, body copy, lesson text, buttons, forms"
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "monospace"
        ],
        "$type": "fontFamily",
        "$description": "Code blocks and inline code, video timestamps, lesson durations, formulas and data values"
      }
    },
    "weight": {
      "regular": {
        "$value": 400,
        "$type": "fontWeight"
      },
      "semibold": {
        "$value": 600,
        "$type": "fontWeight"
      },
      "bold": {
        "$value": 700,
        "$type": "fontWeight"
      }
    },
    "tracking": {
      "tight": {
        "$value": "-0.02em",
        "$type": "dimension",
        "$description": "Display and hero only"
      },
      "normal": {
        "$value": "0",
        "$type": "dimension"
      },
      "wide": {
        "$value": "0.06em",
        "$type": "dimension",
        "$description": "Uppercase eyebrow labels"
      }
    }
  },
  "typography": {
    "caption": {
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "0.75rem",
        "fontWeight": 400,
        "lineHeight": 1.4,
        "letterSpacing": "0"
      },
      "$type": "typography",
      "$description": "12px — timestamps, legal, image/figure credits"
    },
    "small": {
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "0.875rem",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0"
      },
      "$type": "typography",
      "$description": "14px — card metadata, helper text, tags"
    },
    "body": {
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "1rem",
        "fontWeight": 400,
        "lineHeight": 1.6,
        "letterSpacing": "0"
      },
      "$type": "typography",
      "$description": "16px — default UI and body text"
    },
    "body-lg": {
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "1.125rem",
        "fontWeight": 400,
        "lineHeight": 1.7,
        "letterSpacing": "0"
      },
      "$type": "typography",
      "$description": "18px — lesson reading content, course descriptions"
    },
    "label": {
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "1rem",
        "fontWeight": 600,
        "lineHeight": 1.25,
        "letterSpacing": "0"
      },
      "$type": "typography",
      "$description": "16px semibold — buttons, form labels, tabs"
    },
    "eyebrow": {
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "0.75rem",
        "fontWeight": 600,
        "lineHeight": 1.4,
        "letterSpacing": "0.06em"
      },
      "$type": "typography",
      "$description": "12px uppercase — section labels, \"Module 2\""
    },
    "subheading": {
      "$value": {
        "fontFamily": "{font.family.body}",
        "fontSize": "1.125rem",
        "fontWeight": 600,
        "lineHeight": 1.4,
        "letterSpacing": "0"
      },
      "$type": "typography",
      "$description": "18px — card titles, sidebar module names"
    },
    "heading-sm": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "1.25rem",
        "fontWeight": 600,
        "lineHeight": 1.35,
        "letterSpacing": "0"
      },
      "$type": "typography",
      "$description": "20px — course card title, h4"
    },
    "heading": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "1.5rem",
        "fontWeight": 600,
        "lineHeight": 1.3,
        "letterSpacing": "0"
      },
      "$type": "typography",
      "$description": "24px — section titles, h3"
    },
    "heading-lg": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "2.25rem",
        "fontWeight": 600,
        "lineHeight": 1.2,
        "letterSpacing": "0"
      },
      "$type": "typography",
      "$description": "h2 — fluid 28px → 36px",
      "$extensions": {
        "fluid": "clamp(1.75rem, 1.4rem + 1.2vw, 2.25rem)"
      }
    },
    "display": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "3.5rem",
        "fontWeight": 700,
        "lineHeight": 1.1,
        "letterSpacing": "-0.02em"
      },
      "$type": "typography",
      "$description": "h1 / course page title — fluid 36px → 56px",
      "$extensions": {
        "fluid": "clamp(2.25rem, 1.6rem + 2.6vw, 3.5rem)"
      }
    },
    "hero": {
      "$value": {
        "fontFamily": "{font.family.display}",
        "fontSize": "4.5rem",
        "fontWeight": 700,
        "lineHeight": 1.05,
        "letterSpacing": "-0.02em"
      },
      "$type": "typography",
      "$description": "Homepage hero only — fluid 44px → 72px",
      "$extensions": {
        "fluid": "clamp(2.75rem, 1.8rem + 4vw, 4.5rem)"
      }
    },
    "mono": {
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": "0.875rem",
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": "0"
      },
      "$type": "typography",
      "$description": "14px — inline code, durations (12:48), timestamps"
    }
  },
  "space": {
    "0": {
