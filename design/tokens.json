      "$description": "1280px — desktop"
    }
  },
  "radius": {
    "sm": {
      "$value": "0.25rem",
      "$type": "dimension",
      "$description": "4px — tags, badges, checkboxes"
    },
    "md": {
      "$value": "0.5rem",
      "$type": "dimension",
      "$description": "8px — buttons, inputs"
    },
    "lg": {
      "$value": "0.75rem",
      "$type": "dimension",
      "$description": "12px — cards, video player"
    },
    "xl": {
      "$value": "1rem",
      "$type": "dimension",
      "$description": "16px — modals, hero media"
    },
    "full": {
      "$value": "9999px",
      "$type": "dimension",
      "$description": "Avatars, pills, progress bars"
    },
    "tag": {
      "$value": "{radius.sm}",
      "$type": "dimension"
    },
    "button": {
      "$value": "{radius.md}",
      "$type": "dimension"
    },
    "input": {
      "$value": "{radius.md}",
      "$type": "dimension"
    },
    "card": {
      "$value": "{radius.lg}",
      "$type": "dimension"
    },
    "modal": {
      "$value": "{radius.xl}",
      "$type": "dimension"
    },
    "pill": {
      "$value": "{radius.full}",
      "$type": "dimension"
    }
  },
  "shadow": {
    "light": {
      "sm": {
        "$value": {
          "color": "rgba(28, 25, 23, 0.06)",
          "offsetX": "0",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0"
        },
        "$type": "shadow",
        "$description": "Resting cards"
      },
      "md": {
        "$value": [
          {
            "color": "rgba(28, 25, 23, 0.10)",
            "offsetX": "0",
            "offsetY": "4px",
            "blur": "12px",
            "spread": "-2px"
          },
          {
            "color": "rgba(28, 25, 23, 0.06)",
            "offsetX": "0",
            "offsetY": "2px",
            "blur": "4px",
            "spread": "-2px"
          }
        ],
        "$type": "shadow",
        "$description": "Card hover, dropdowns"
