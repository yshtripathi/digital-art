      "$description": "20px"
    },
    "6": {
      "$value": "1.5rem",
      "$type": "dimension",
      "$description": "24px"
    },
    "8": {
      "$value": "2rem",
      "$type": "dimension",
      "$description": "32px"
    },
    "10": {
      "$value": "2.5rem",
      "$type": "dimension",
      "$description": "40px"
    },
    "12": {
      "$value": "3rem",
      "$type": "dimension",
      "$description": "48px"
    },
    "16": {
      "$value": "4rem",
      "$type": "dimension",
      "$description": "64px"
    },
    "20": {
      "$value": "5rem",
      "$type": "dimension",
      "$description": "80px"
    },
    "24": {
      "$value": "6rem",
      "$type": "dimension",
      "$description": "96px"
    }
  },
  "layout": {
    "container-max": {
      "$value": "80rem",
      "$type": "dimension",
      "$description": "1280px"
    },
    "container-padding": {
      "$value": "2rem",
      "$type": "dimension",
      "$description": "Fluid 16px → 32px",
      "$extensions": {
        "fluid": "clamp(1rem, 0.5rem + 2vw, 2rem)"
      }
    },
    "reading-max": {
      "$value": "70ch",
      "$type": "dimension",
      "$description": "Max line length for lesson text"
    },
    "sidebar-width": {
      "$value": "20rem",
      "$type": "dimension",
      "$description": "Curriculum sidebar"
    },
    "header-height": {
      "$value": "4rem",
      "$type": "dimension"
    },
    "section-gap": {
      "$value": "6rem",
      "$type": "dimension",
      "$description": "Fluid 48px → 96px",
      "$extensions": {
        "fluid": "clamp(3rem, 2rem + 4vw, 6rem)"
      }
    },
    "card-padding": {
      "$value": "{space.5}",
      "$type": "dimension"
    },
    "grid-gap": {
      "$value": "{space.6}",
      "$type": "dimension"
    },
    "touch-target": {
      "$value": "2.75rem",
      "$type": "dimension",
      "$description": "44px minimum tap size"
    }
  },
  "breakpoint": {
